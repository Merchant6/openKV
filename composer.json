{
    "name": "saboor/swoole-kv",
    "description": "Redis-inspired in-memory key-value database built with PHP and OpenSwoole",
    "type": "project",
    "require": {
        "php": "^8.3",
        "openswoole/core": "^22.1",
        "symfony/console": "^7.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Saboor\\SwooleKv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saboor\\SwooleKv\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Merchant6",
            "email": "saboormerchant6@gmail.com"
        }
    ],
    "bin": [
        "bin/swoole-kv"
    ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0"
    }
}
